# Copie para .env e ajuste se quiser mudar o padrão.

# Padrão: SQLite local (data/processed/anp_combustiveis.db), sem dependências externas.
# Para usar Postgres: DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost:5432/anp
DATABASE_URL=sqlite:///data/processed/anp_combustiveis.db

# Janela de anos baixada pela ANP em src/extract.py (a série mensal unificada
# começa em 2023; antes disso só existe a série semestral antiga, não usada aqui).
ANP_ANO_INICIO=2023
ANP_ANO_FIM=2025
